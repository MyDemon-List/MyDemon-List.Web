@page "/admin"
@page "/fr/admin"
@page "/en/admin"
@page "/es/admin"
@inject Traductions Texte

<SeoHead Titre="@Texte["AdministrationSite", "Administration du site"]"
         Description="@Texte["SeoAdministrationDescription", "Administration de My Demon List."]"
         CheminCanonique="/admin"
         NePasIndexer="true" />

@if (_isLoading)
{
    <p class="chargement">@Texte["Chargement", "Chargement..."]</p>
}
else if (!_estAutorise)
{
    <p class="chargement">@Texte["AccesRefuse", "Accès refusé."]</p>
}
else
{
    <div class="gestion-page">
      <div class="gestion-page-contenu">
        <nav class="onglets" aria-label="Navigation de l'administration du site">
            <button type="button" class="onglet @(_ongletActuel == Onglet.Fusions ? "active" : "")"
                    aria-pressed="@(_ongletActuel == Onglet.Fusions)" @onclick="() => _ongletActuel = Onglet.Fusions">
                <span>@Texte["Fusions", "Fusions"]</span>
                @if (_fusionsEnAttente.Count > 0)
                {
                    <span class="onglet-compteur">@_fusionsEnAttente.Count</span>
                }
            </button>
            <button type="button" class="onglet @(_ongletActuel == Onglet.Quotas ? "active" : "")"
                    aria-pressed="@(_ongletActuel == Onglet.Quotas)" @onclick="() => _ongletActuel = Onglet.Quotas">
                <span>@Texte["DemandesQuota", "Demandes de quota"]</span>
                @if ((_demandesNiveaux.Count + _demandesListes.Count) > 0)
                {
                    <span class="onglet-compteur">@(_demandesNiveaux.Count + _demandesListes.Count)</span>
                }
            </button>
            @if (_estChef)
            {
                <button type="button" class="onglet @(_ongletActuel == Onglet.Admins ? "active" : "")"
                        aria-pressed="@(_ongletActuel == Onglet.Admins)" @onclick="() => _ongletActuel = Onglet.Admins">
                    <span>@Texte["AdminsSite", "Admins du site"]</span>
                </button>
                <button type="button" class="onglet @(_ongletActuel == Onglet.FusionForcee ? "active" : "")"
                        aria-pressed="@(_ongletActuel == Onglet.FusionForcee)" @onclick="() => _ongletActuel = Onglet.FusionForcee">
                    <span>@Texte["FusionForcee", "Fusion forcée"]</span>
                </button>
            }
            <button type="button" class="onglet @(_ongletActuel == Onglet.Notifications ? "active" : "")"
                    aria-pressed="@(_ongletActuel == Onglet.Notifications)" @onclick="() => _ongletActuel = Onglet.Notifications">
                <span>@Texte["Notifications", "Notifications"]</span>
            </button>
        </nav>

        @if (_ongletActuel == Onglet.Fusions)
        {
            <div class="carte-admin">
                <h2>@Texte["DemandesFusionCompte", "Demandes de fusion de compte"]</h2>

                @if (!string.IsNullOrEmpty(_fusionMessage))
                {
                    <div class="alert">@_fusionMessage</div>
                }

                @if (_fusionsEnAttente.Count == 0)
                {
                    <p class="aucun-niveau">@Texte["AucuneFusionAttente", "Aucune demande de fusion en attente."]</p>
                }
                else
                {
                    @foreach (FusionAffichage demande in _fusionsEnAttente)
                    {
                        <div class="ligne-demande">
                            <div class="infos-demande">
                                <strong>@demande.Demandeur.Nom</strong> → <strong>@demande.Cible.Nom</strong>
                                <span class="details-demande">@Texte.Formater("FusionResume", "nom conservé : {0} — demandé le {1}", demande.NomConserve, demande.DateDemande.ToString("g", Texte.Culture))</span>
                            </div>

                            <div class="comptes-fusion">
                                <div class="compte-fusion">
                                    <span class="compte-fusion-label">@Texte["Demandeur", "Demandeur"]</span>
                                    <strong>@demande.Demandeur.Nom</strong>
                                    <span class="details-demande">@((demande.Demandeur.DiscordUsername ?? demande.Demandeur.DiscordDisplayName) is not null ? $"Discord : {demande.Demandeur.DiscordDisplayName ?? "?"} ({demande.Demandeur.DiscordUsername ?? "?"})" : Texte["AucunCompteDiscord", "Pas de compte Discord lié"])</span>
                                    <span class="details-demande">@ResumeActiviteFusion(demande.Demandeur)</span>
                                </div>
                                <div class="compte-fusion">
                                    <span class="compte-fusion-label">@Texte["Cible", "Cible"]</span>
                                    <strong>@demande.Cible.Nom</strong>
                                    <span class="details-demande">@((demande.Cible.DiscordUsername ?? demande.Cible.DiscordDisplayName) is not null ? $"Discord : {demande.Cible.DiscordDisplayName ?? "?"} ({demande.Cible.DiscordUsername ?? "?"})" : Texte["AucunCompteDiscord", "Pas de compte Discord lié"])</span>
                                    <span class="details-demande">@ResumeActiviteFusion(demande.Cible)</span>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(demande.Motif))
                            {
                                <div class="details-demande">@Texte["Motif", "Motif"] : @demande.Motif</div>
                            }

                            @if (EstImpliqueDansFusion(demande))
                            {
                                <div class="details-demande">@Texte["FusionAdminConcerne", "Vous êtes concerné par cette demande — un autre admin du site doit la traiter."]</div>
                            }
                            else
                            {
                                <div class="actions">
                                    <button type="button" class="btn" @onclick="() => AccepterFusionAdmin(demande)">@Texte["Accepter", "Accepter"]</button>
                                    <button type="button" class="btn-danger" @onclick="() => RefuserFusionAdmin(demande)">@Texte["Refuser", "Refuser"]</button>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
        else if (_ongletActuel == Onglet.Quotas)
        {
            <div class="carte-admin">
                <h2>@Texte["DemandesNiveauxSupplementaires", "Demandes de niveaux supplémentaires"]</h2>

                @if (!string.IsNullOrEmpty(_quotaMessage))
                {
                    <div class="alert">@_quotaMessage</div>
                }

                @if (_demandesNiveaux.Count == 0)
                {
                    <p class="aucun-niveau">@Texte["AucuneDemandeAttente", "Aucune demande en attente."]</p>
                }
                else
                {
                    @foreach (DemandeNiveauxAffichage demande in _demandesNiveaux)
                    {
                        <div class="carte-demande-quota">
                            <div class="infos-demande">
                                <strong>@demande.ListeNom</strong> @Texte.Formater("ParAuteur", "par {0}", demande.DemandeurNom)
                                <span class="details-demande">@Texte.Formater("PalierNiveauxResume", "Palier : {0} → {1} niveaux — demandé le {2}", demande.LimiteActuelle, demande.ProchaineLimite, demande.DateDemande.ToString("g", Texte.Culture))</span>
                            </div>

                            <div class="scroll-noms">
                                @foreach (string nom in demande.NomsNiveaux)
                                {
                                    <div class="nom-niveau-ligne">@nom</div>
                                }
                            </div>

                            <div class="actions">
                                <button type="button" class="btn" @onclick="() => AccepterDemandeNiveaux(demande.Id)">@Texte["Accepter", "Accepter"]</button>
                                <button type="button" class="btn-danger" @onclick="() => RefuserDemandeNiveaux(demande.Id)">@Texte["Refuser", "Refuser"]</button>
                            </div>
                        </div>
                    }
                }

                <h2>@Texte["DemandesListesSupplementaires", "Demandes de listes supplémentaires"]</h2>

                @if (_demandesListes.Count == 0)
                {
                    <p class="aucun-niveau">@Texte["AucuneDemandeAttente", "Aucune demande en attente."]</p>
                }
                else
                {
                    @foreach (DemandeListesAffichage demande in _demandesListes)
                    {
                        <div class="carte-demande-quota">
                            <div class="infos-demande">
                                <strong>@demande.DemandeurNom</strong>
                                <span class="details-demande">@Texte.Formater("PalierListesResume", "Palier : {0} → {1} listes — demandé le {2}", demande.LimiteActuelle, demande.ProchaineLimite, demande.DateDemande.ToString("g", Texte.Culture))</span>
                            </div>

                            @if (demande.ListesExistantes.Count > 0)
                            {
                                <div class="liens-listes">
                                    @foreach (ListeRef liste in demande.ListesExistantes)
                                    {
                                        <button type="button" class="chip chip-bouton" @onclick="() => PrevisualiserListe(liste)">@liste.Nom</button>
                                    }
                                </div>
                            }

                            <div class="actions">
                                <button type="button" class="btn" @onclick="() => AccepterDemandeListes(demande.Id)">@Texte["Accepter", "Accepter"]</button>
                                <button type="button" class="btn-danger" @onclick="() => RefuserDemandeListes(demande.Id)">@Texte["Refuser", "Refuser"]</button>
                            </div>
                        </div>
                    }
                }
            </div>
        }
        else if (_ongletActuel == Onglet.Admins && _estChef)
        {
            <div class="carte-admin">
                <h2>@Texte["AdminsSite", "Admins du site"]</h2>

                @if (!string.IsNullOrEmpty(_adminsErreur))
                {
                    <div class="alert alert-error">@_adminsErreur</div>
                }

                @if (_admins.Count == 0)
                {
                    <p class="aucun-niveau">@Texte["AucunAdminSite", "Aucun admin du site pour l'instant."]</p>
                }
                else
                {
                    @foreach (AdminLigne admin in _admins)
                    {
                        <div class="membre-ligne">
                            <div class="membre-infos">
                                <span class="membre-nom">@admin.NomSite</span>
                                <span class="membre-discord">Discord : @(admin.DiscordDisplayName ?? "?") (@(admin.DiscordUsername ?? "?"))</span>
                            </div>
                            <button type="button" class="btn-danger" @onclick="() => DemanderRevocationAdmin(admin)">@Texte["Retirer", "Retirer"]</button>
                        </div>
                    }
                }

                @if (_afficherConfirmationRevocationAdmin && _adminARevoquer is not null)
                {
                    <div class="modal-backdrop" @onclick="AnnulerRevocationAdmin"></div>
                    <div class="modal-confirm">
                        <p>@Texte.Formater("RetirerAdminQuestion", "Retirer le rôle d'admin du site à {0} ?", _adminARevoquer.NomSite)</p>
                        <div class="modal-actions">
                            <button type="button" class="btn-danger" @onclick="ConfirmerRevocationAdmin">@Texte["Confirmer", "Confirmer"]</button>
                            <button type="button" @onclick="AnnulerRevocationAdmin">@Texte["Annuler", "Annuler"]</button>
                        </div>
                    </div>
                }

                <div class="ajout-membre champ champ-autocomplete">
                    <h3>@Texte["NommerAdmin", "Nommer un admin"]</h3>
                    <label for="admin-recherche">@Texte["RechercheAdminAide", "Rechercher (nom dans le site, pseudo Discord ou tag Discord)"]</label>
                    <input id="admin-recherche" class="input" value="@_rechercheAdminInput" @oninput="OnRechercheAdminInput" autocomplete="off" placeholder="@Texte["RechercheAdminPlaceholder", "Rechercher un utilisateur relié à Discord..."]" />
                    @if (_rechercheAdminSuggestions.Count > 0)
                    {
                        <div class="suggestions">
                            @foreach (DiscordUtilisateurSuggestion candidat in _rechercheAdminSuggestions)
                            {
                                <div class="suggestion suggestion-discord" @onclick="() => SelectCandidatAdmin(candidat)">
                                    <span class="suggestion-nom">@candidat.NomSite</span>
                                    <span class="suggestion-discord-info">Discord : @(candidat.DiscordDisplayName ?? "?") (@(candidat.DiscordUsername ?? "?"))</span>
                                </div>
                            }
                        </div>
                    }

                    @if (_candidatAdminSelectionne is not null)
                    {
                        <div class="actions-formulaire">
                            <button type="button" class="btn" @onclick="NommerAdminAsync" disabled="@_nominationEnCours">
                                @(_nominationEnCours ? Texte["NominationEnCours", "Nomination..."] : Texte.Formater("NommerAdminUtilisateur", "Nommer {0} admin du site", _candidatAdminSelectionne.NomSite))
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
        else if (_ongletActuel == Onglet.FusionForcee && _estChef)
        {
            <div class="carte-admin">
                <h2>@Texte["FusionForcee", "Fusion forcée"]</h2>
                <p class="details-demande">@Texte["FusionForceeAide", "Fusionne directement deux comptes sans passer par une demande. Uniquement possible si un seul des deux comptes est relié à Discord : ce compte est conservé, l'autre lui est fusionné puis supprimé."]</p>

                @if (!string.IsNullOrEmpty(_fusionDirecteMessage))
                {
                    <div class="alert">@_fusionDirecteMessage</div>
                }

                <div class="comptes-fusion">
                    <div class="champ champ-autocomplete">
                        <label for="fusion-directe-1">@Texte["PremierCompte", "Premier compte"]</label>
                        <input id="fusion-directe-1" class="input" value="@_rechercheFusionDirecte1" @oninput="e => RechercherCompteFusionDirecte(e, true)" autocomplete="off" placeholder="@Texte["RechercheCompteFusionPlaceholder", "Nom du site, pseudo ou tag Discord..."]" />
                        @if (_suggestionsFusionDirecte1.Count > 0)
                        {
                            <div class="suggestions">
                                @foreach (CompteFusionDirecte candidat in _suggestionsFusionDirecte1)
                                {
                                    <div class="suggestion suggestion-discord" @onclick="() => SelectCompteFusionDirecte(candidat, true)">
                                        <span class="suggestion-nom">@candidat.NomSite</span>
                                        <span class="suggestion-discord-info">@(candidat.ADiscord ? $"Discord : {candidat.DiscordDisplayName ?? "?"} ({candidat.DiscordUsername ?? "?"})" : Texte["AucunCompteDiscord", "Pas de compte Discord lié"])</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="champ champ-autocomplete">
                        <label for="fusion-directe-2">@Texte["SecondCompte", "Second compte"]</label>
                        <input id="fusion-directe-2" class="input" value="@_rechercheFusionDirecte2" @oninput="e => RechercherCompteFusionDirecte(e, false)" autocomplete="off" placeholder="@Texte["RechercheCompteFusionPlaceholder", "Nom du site, pseudo ou tag Discord..."]" />
                        @if (_suggestionsFusionDirecte2.Count > 0)
                        {
                            <div class="suggestions">
                                @foreach (CompteFusionDirecte candidat in _suggestionsFusionDirecte2)
                                {
                                    <div class="suggestion suggestion-discord" @onclick="() => SelectCompteFusionDirecte(candidat, false)">
                                        <span class="suggestion-nom">@candidat.NomSite</span>
                                        <span class="suggestion-discord-info">@(candidat.ADiscord ? $"Discord : {candidat.DiscordDisplayName ?? "?"} ({candidat.DiscordUsername ?? "?"})" : Texte["AucunCompteDiscord", "Pas de compte Discord lié"])</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                @if (ComptesFusionDirecteIdentiques)
                {
                    <div class="alert alert-error">@Texte["FusionForceeComptesIdentiques", "Choisissez deux comptes différents."]</div>
                }
                else if (ConditionDiscordFusionDirecteInvalide)
                {
                    <div class="alert alert-error">@Texte["FusionForceeConditionDiscord", "La fusion directe n'est possible que si un seul des deux comptes est relié à Discord."]</div>
                }

                <div class="actions-formulaire">
                    <button type="button" class="btn" disabled="@(!PeutConfirmerFusionDirecte || _fusionDirecteEnCours)" @onclick="DemanderFusionDirecte">
                        @(_fusionDirecteEnCours ? Texte["FusionEnCours", "Fusion..."] : Texte["FusionnerCompte", "Fusionner un compte"])
                    </button>
                </div>

                @if (_afficherConfirmationFusionDirecte && _compteFusionDirecte1 is not null && _compteFusionDirecte2 is not null)
                {
                    CompteFusionDirecte cibleFusionDirecte = _compteFusionDirecte1.ADiscord ? _compteFusionDirecte1 : _compteFusionDirecte2;
                    CompteFusionDirecte sourceFusionDirecte = _compteFusionDirecte1.ADiscord ? _compteFusionDirecte2 : _compteFusionDirecte1;

                    <div class="modal-backdrop" @onclick="AnnulerFusionDirecte"></div>
                    <div class="modal-confirm">
                        <p>@Texte.Formater("FusionForceeConfirmation", "Fusionner {0} dans {1} ? {0} sera supprimé et toutes ses données transférées à {1}. Cette action est irréversible.", sourceFusionDirecte.NomSite, cibleFusionDirecte.NomSite)</p>
                        <div class="modal-actions">
                            <button type="button" class="btn-danger" @onclick="ConfirmerFusionDirecteAsync">@Texte["Confirmer", "Confirmer"]</button>
                            <button type="button" @onclick="AnnulerFusionDirecte">@Texte["Annuler", "Annuler"]</button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (_ongletActuel == Onglet.Notifications)
        {
            <div class="carte-admin carte-envoi-notification">
                <div>
                    <h2>@Texte["EnvoyerNotification", "Envoyer une notification"]</h2>
                    <p class="details-demande">@Texte["EnvoyerNotificationAide", "Le message apparaîtra dans le centre de notifications du destinataire."]</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(_notificationAdminMessage))
                {
                    <div class="alert">@_notificationAdminMessage</div>
                }

                @if (_estChef)
                {
                    <label class="choix-tous">
                        <input type="checkbox" checked="@_notificationPourTous" @onchange="BasculerNotificationPourTous" />
                        <span>
                            <strong>@Texte["TousUtilisateurs", "Tous les utilisateurs"]</strong>
                            <small>@Texte["TousUtilisateursAide", "Envoie le message à tous les comptes reliés à Discord."]</small>
                        </span>
                    </label>
                }

                @if (!_notificationPourTous)
                {
                    <div class="champ champ-autocomplete">
                        <label for="notification-destinataire">@Texte["Destinataire", "Destinataire"]</label>
                        <input id="notification-destinataire"
                               class="input"
                               value="@_rechercheDestinataireNotification"
                               @oninput="RechercherDestinataireNotification"
                               autocomplete="off"
                               placeholder="@Texte["RechercheUtilisateurDiscord", "Nom du site, pseudo ou tag Discord..."]" />
                        @if (_suggestionsDestinatairesNotification.Count > 0)
                        {
                            <div class="suggestions">
                                @foreach (DestinataireNotification destinataire in _suggestionsDestinatairesNotification)
                                {
                                    <button type="button" class="suggestion suggestion-discord" @onclick="() => SelectionnerDestinataireNotification(destinataire)">
                                        <span class="suggestion-nom">@destinataire.NomSite</span>
                                        <span class="suggestion-discord-info">Discord : @(destinataire.DiscordDisplayName ?? "?") (@(destinataire.DiscordUsername ?? "?"))</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }

                <div class="champ">
                    <label for="notification-titre">@Texte["Titre", "Titre"]</label>
                    <input id="notification-titre" class="input" @bind="_titreNotification" maxlength="160" placeholder="@Texte["TitreNotificationPlaceholder", "Une information importante"]" />
                </div>

                <div class="champ">
                    <label for="notification-message">@Texte["Message", "Message"]</label>
                    <textarea id="notification-message" class="input textarea-notification" @bind="_messageNotification" maxlength="2000" placeholder="@Texte["MessageNotificationPlaceholder", "Écrivez le message à afficher..."]"></textarea>
                </div>

                <div class="champ">
                    <label for="notification-lien">@Texte["LienInterne", "Lien interne"] <span class="details-demande">@Texte["Facultatif", "(facultatif)"]</span></label>
                    <input id="notification-lien" class="input" @bind="_lienNotification" maxlength="500" placeholder="/profil" />
                </div>

                <div class="actions-formulaire">
                    <button type="button" class="btn" @onclick="EnvoyerNotificationAdminAsync" disabled="@_envoiNotificationEnCours">
                        @(_envoiNotificationEnCours ? Texte["EnvoiEnCours", "Envoi..."] : Texte["EnvoyerNotification", "Envoyer la notification"])
                    </button>
                </div>
            </div>
        }
      </div>
    </div>
}
