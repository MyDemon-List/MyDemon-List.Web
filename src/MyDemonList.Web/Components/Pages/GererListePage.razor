@page "/liste/gerer"
@page "/liste/{ListeId:int}/{Slug}/gerer"
@page "/fr/liste/gerer"
@page "/fr/liste/{ListeId:int}/{Slug}/gerer"
@page "/en/liste/gerer"
@page "/en/liste/{ListeId:int}/{Slug}/gerer"
@page "/es/liste/gerer"
@page "/es/liste/{ListeId:int}/{Slug}/gerer"
@using Microsoft.AspNetCore.Components.Forms
@using MyDemonList.Web.Utils
@using System.IO

<SeoHead Titre="@ObtenirTitrePage()"
         Description="@Texte["SeoGestionListeDescription", "Gérez les niveaux, soumissions, membres et paramètres de cette demon list."]"
         CheminCanonique="@ObtenirCheminCanonique()"
         NePasIndexer="true" />

@if (_isLoading)
{
    <p class="chargement">@Texte["Chargement", "Chargement..."]</p>
}
else if (!_estAutorise)
{
    <p class="chargement">@Texte["AccesRefuse", "Accès refusé."]</p>
}
else
{
    <div class="gestion-page">
      <div class="gestion-page-contenu">
        <header class="gestion-entete">
            <div>
                <h1>@_listeNom</h1>
                <p>@Texte["GestionListeSousTitre", "Gestion de la liste"]</p>
            </div>
            @if (PeutVoirOngletNiveaux)
            {
                <span class="gestion-compteur">@_niveaux.Count @Texte[_niveaux.Count > 1 ? "Niveaux" : "Niveau", _niveaux.Count > 1 ? "niveaux" : "niveau"]</span>
            }
        </header>

        @if (_listeEstSupprimee)
        {
            <div class="liste-supprimee-banniere">
                <div>
                    <strong>@Texte["ListeSupprimeeTitre", "Cette liste est supprimée"]</strong>
                    <span>@Texte["ListeSupprimeeAide", "Elle n'est plus visible publiquement, mais toutes ses données sont conservées."]</span>
                </div>
                <button type="button" class="btn-restaurer" @onclick="OuvrirRestaurationListe">@Texte["RestaurerListe", "Restaurer la liste"]</button>
            </div>
        }

        <nav class="onglets" aria-label="Navigation de gestion de la liste">
            @if (PeutVoirOngletNiveaux && !_listeEstSupprimee)
            {
                <button type="button" class="onglet @(_ongletActuel == Onglet.Niveaux ? "active" : "")"
                        aria-pressed="@(_ongletActuel == Onglet.Niveaux)" @onclick="() => _ongletActuel = Onglet.Niveaux">
                    <span>@Texte["Niveaux", "Niveaux"]</span>
                </button>
                <button type="button" class="onglet @(_ongletActuel == Onglet.Formulaire ? "active" : "")"
                        aria-pressed="@(_ongletActuel == Onglet.Formulaire)" @onclick="OuvrirCreation">
                    <span>@Texte["AjouterNiveau", "Ajouter un niveau"]</span>
                </button>
            }
            @if (!_listeEstSupprimee)
            {
                <button type="button" class="onglet @(_ongletActuel == Onglet.Soumissions ? "active" : "")"
                        aria-pressed="@(_ongletActuel == Onglet.Soumissions)" @onclick="() => _ongletActuel = Onglet.Soumissions">
                    <span>@Texte["Soumissions", "Soumissions"]</span>
                    @if (_soumissions.Count > 0)
                    {
                        <span class="onglet-compteur">@_soumissions.Count</span>
                    }
                </button>
            }
            @if (PeutVoirOngletModeration && !_listeEstSupprimee)
            {
                <button type="button" class="onglet @(_ongletActuel == Onglet.Moderation ? "active" : "")"
                        aria-pressed="@(_ongletActuel == Onglet.Moderation)" @onclick="() => _ongletActuel = Onglet.Moderation">
                    <span>@Texte["Moderation", "Modération"]</span>
                </button>
            }
            @if (PeutVoirOngletParametres && !_listeEstSupprimee)
            {
                <button type="button" class="onglet @(_ongletActuel == Onglet.Parametres ? "active" : "")"
                        aria-pressed="@(_ongletActuel == Onglet.Parametres)" @onclick="() => _ongletActuel = Onglet.Parametres">
                    <span>@Texte["Parametres", "Paramètres"]</span>
                </button>
            }
            @if (PeutVoirOngletHistorique)
            {
                <button type="button" class="onglet @(_ongletActuel == Onglet.Historique ? "active" : "")"
                        aria-pressed="@(_ongletActuel == Onglet.Historique)" @onclick="() => _ongletActuel = Onglet.Historique">
                    <span>@Texte["Historique", "Historique"]</span>
                </button>
            }
        </nav>

        @if (_ongletActuel == Onglet.Niveaux && PeutVoirOngletNiveaux)
        {
            <div class="outils-niveaux">
                <div class="recherche-niveau">
                    <input type="search"
                           class="input recherche-niveau-input"
                           aria-label="@Texte["RechercherNiveauNom", "Rechercher un niveau par son nom"]"
                           placeholder="@Texte["RechercherNiveau", "Rechercher un niveau..."]"
                           autocomplete="off"
                           spellcheck="false"
                           @bind="_rechercheNiveau"
                           @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(_rechercheNiveau))
                    {
                        <button type="button"
                                class="recherche-effacer"
                                aria-label="@Texte["EffacerRecherche", "Effacer la recherche"]"
                                title="@Texte["EffacerRecherche", "Effacer la recherche"]"
                                @onclick="() => _rechercheNiveau = string.Empty">×</button>
                    }
                </div>
            </div>

            <div class="table-niveaux">
                @{
                    List<LigneNiveau> toutesLignes = ObtenirLignes();
                    List<LigneNiveau> lignes = FiltrerLignesParNom(toutesLignes);
                }
                @if (lignes.Count == 0)
                {
                    <p class="aucun-niveau">
                        @(toutesLignes.Count == 0
                            ? Texte["AucunNiveauListe", "Aucun niveau dans cette liste pour l'instant."]
                            : Texte["AucunNiveauRecherche", "Aucun niveau ne correspond à cette recherche."])
                    </p>
                }
                else
                {
                    @foreach (LigneNiveau ligne in lignes)
                    {
                        <div @key="ligne.Classement.Id"
                             class="@ObtenirClasseLigneNiveau(ligne.Classement.Id)"
                             style="@ObtenirStyleLigneNiveau(ligne.Classement.Id)">
                            <span class="ligne-niveau-bg" style=@($"background-image:url('/MiniaturesNiveaux/{ligne.Niveau.Id}.png')")></span>
                            <span class="ligne-niveau-shade"></span>

                            <span class="position">#@ligne.Classement.ClassementPosition</span>

                            <div class="position-edit">
                                <input type="number" min="1" max="@toutesLignes.Count" class="input input-position"
                                       title="@Texte["NouvellePosition", "Nouvelle position"]"
                                       value="@ObtenirPositionSaisie(ligne)"
                                       disabled="@_deplacementEnCours"
                                       @oninput="e => OnPositionInput(ligne.Classement.Id, e)"
                                       @onkeydown="e => OnPositionKeyDown(e, ligne.Classement.Id)" />
                                <button type="button" title="@Texte["DeplacerPosition", "Déplacer à cette position"]" disabled="@_deplacementEnCours" @onclick="() => ValiderPosition(ligne.Classement.Id)">✓</button>
                            </div>

                            <div class="infos">
                                <span class="nom">@ligne.Niveau.Nom</span>
                                <div class="details">
                                    <span class="chip">@ligne.Classement.Points pts</span>
                                    <span class="chip">@ligne.Niveau.Rating?.Nom</span>
                                    <span class="chip">@Texte["Publieur", "Publieur"] : @ligne.Niveau.Publisher?.Nom</span>
                                    <span class="chip">@Texte["Verifieur", "Vérifieur"] : @ligne.Niveau.Verifieur?.Nom</span>
                                    @if (ligne.NomsCreateurs.Count > 0)
                                    {
                                        <span class="chip chip-createurs-liste">@Texte["Createurs", "Créateurs"] : @string.Join(", ", ligne.NomsCreateurs)</span>
                                    }
                                </div>
                            </div>

                            <div class="actions">
                                <button type="button" title="@Texte["Monter", "Monter"]" disabled="@_deplacementEnCours" @onclick="() => MonterNiveau(ligne.Classement.Id)">▲</button>
                                <button type="button" title="@Texte["Descendre", "Descendre"]" disabled="@_deplacementEnCours" @onclick="() => DescendreNiveau(ligne.Classement.Id)">▼</button>
                                <button type="button" disabled="@_deplacementEnCours" @onclick="async () => await OuvrirEdition(ligne)">@Texte["Modifier", "Modifier"]</button>
                                @if (PeutSupprimerNiveaux)
                                {
                                    <button type="button" class="btn-danger" disabled="@_deplacementEnCours" @onclick="() => DemanderSuppression(ligne.Niveau.Id)">@Texte["Supprimer", "Supprimer"]</button>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            @if (_afficherConfirmationSuppression)
            {
                <div class="modal-backdrop" @onclick="AnnulerSuppression"></div>
                <div class="modal-confirm">
                    <p>@Texte["SupprimerNiveauConfirmation", "Supprimer ce niveau ainsi que son classement, ses réussites et ses soumissions associées ?"]</p>
                    <div class="modal-actions">
                        <button type="button" class="btn-danger" @onclick="ConfirmerSuppression">@Texte["Confirmer", "Confirmer"]</button>
                        <button type="button" @onclick="AnnulerSuppression">@Texte["Annuler", "Annuler"]</button>
                    </div>
                </div>
            }
        }
        else if (_ongletActuel == Onglet.Formulaire && PeutModifierNiveaux)
        {
            @if (_niveauEnEditionId is null && !PeutAjouterNiveauSansDemande)
            {
                <div class="formulaire-niveau">
                    <h2>@Texte["LimiteNiveauxAtteinte", "Limite de niveaux atteinte"]</h2>

                    @if (_demandeNiveauxEnCours)
                    {
                        <div class="alert alert-info">
                            @Texte.Formater("DemandeNiveauxEnCours", "Demande en cours de traitement (passage de {0} à {1} niveaux).", LimiteNiveauxActuelle, ProchaineLimiteNiveaux)
                        </div>
                    }
                    else if (CooldownRestantNiveaux is TimeSpan restant)
                    {
                        <div class="alert alert-info">
                            @Texte.Formater("DemandeNiveauxRefusee", "Demande refusée. Vous pourrez redemander dans {0}.", FormaterDuree(restant))
                        </div>
                    }
                    else
                    {
                        <p>@Texte.Formater("LimiteNiveauxListe", "Cette liste a atteint la limite de {0} niveaux.", LimiteNiveauxActuelle)</p>
                        <button type="button" class="btn" @onclick="DemanderAugmentationNiveaux">@Texte.Formater("DemanderLimiteNiveaux", "Demander le passage à {0} niveaux", ProchaineLimiteNiveaux)</button>
                    }

                    <div class="actions-formulaire">
                        <button type="button" @onclick="() => _ongletActuel = Onglet.Niveaux">@Texte["Retour", "Retour"]</button>
                    </div>
                </div>
            }
            else
            {
            <div class="formulaire-niveau formulaire-niveau-editor">
                <div class="formulaire-entete">
                    <h2>@(_niveauEnEditionId is null ? Texte["AjouterNiveauTitre", "Ajouter un niveau"] : Texte["ModifierNiveau", "Modifier le niveau"])</h2>
                    <p>@(_niveauEnEditionId is null
                        ? Texte["AjouterNiveauAide", "Renseignez l'ID du niveau puis vérifiez les informations récupérées."]
                        : Texte["ModifierNiveauAide", "Mettez à jour les informations du niveau sélectionné."])</p>
                </div>

                <div class="champ champ-id-jeu @(EstPremierNiveau ? "champ-id-jeu-premier" : "")">
                    <label for="niveau-id-jeu">@Texte["IdNiveauJeu", "ID du niveau dans le jeu"]</label>
                    <input id="niveau-id-jeu" class="input @(_formIdDuNiveauErreur is not null ? "input-erreur" : null)"
                           value="@_formIdDuNiveauDansLeJeu" @oninput="OnIdDuNiveauInput"
                           inputmode="numeric" autocomplete="off" placeholder="Ex : 12345678" />
                    @if (_formIdDuNiveauErreur is not null)
                    {
                        <small class="erreur-champ">@_formIdDuNiveauErreur</small>
                    }
                    else if (EstPremierNiveau)
                    {
                        <small>@Texte["RecuperationNiveauAide", "Le nom, le publieur, la difficulté et la miniature sont récupérés automatiquement lorsqu'ils sont disponibles."]</small>
                    }
                </div>

                @if (AfficheChampsDesactive)
                {
                    <div class="champ champ-nom">
                        <label for="niveau-nom">@Texte["Nom", "Nom"]</label>
                        <input id="niveau-nom" class="input" @bind="_formNom" @bind:event="oninput" maxlength="128" />
                    </div>

                    <div class="champ champ-url">
                        <label for="niveau-url-verif">@Texte["UrlVerification", "URL de vérification"]</label>
                        <input id="niveau-url-verif" class="input" @bind="_formUrlVerification" @bind:event="oninput" placeholder="https://..." />
                    </div>

                    <div class="champ-ligne champ-duree">
                        <div class="champ">
                            <label for="niveau-duree-min">@Texte["DureeMinutes", "Durée (minutes)"]</label>
                            <input id="niveau-duree-min" type="number" min="0" class="input" @bind="_formDureeMinutes" />
                        </div>
                        <div class="champ">
                            <label for="niveau-duree-sec">@Texte["DureeSecondes", "Durée (secondes)"]</label>
                            <input id="niveau-duree-sec" type="number" min="0" max="59" class="input" @bind="_formDureeSecondes" />
                        </div>
                    </div>

                    <div class="champ champ-difficulte">
                        <div class="difficulte-entete">
                            <label id="niveau-rating-label">@Texte["Difficulte", "Difficulté"]</label>
                            @if (DifficulteSelectionnee is Difficulte difficulteSelectionnee)
                            {
                                <span class="difficulte-selection-actuelle">@difficulteSelectionnee.Nom</span>
                            }
                        </div>

                        <div class="difficulte-selecteur" role="group" aria-labelledby="niveau-rating-label">
                            <div class="difficulte-groupe">
                                <span class="difficulte-groupe-titre">@Texte["Classiques", "Classiques"]</span>
                                <div class="difficulte-options difficulte-options-principales">
                                    @foreach (Difficulte difficulte in ObtenirDifficultesPrincipales(false))
                                    {
                                        bool estSelectionnee = EstDifficultePrincipaleSelectionnee(difficulte);
                                        <button type="button"
                                                class="difficulte-option @(estSelectionnee ? "selectionnee" : null)"
                                                aria-pressed="@estSelectionnee"
                                                title="@difficulte.Nom"
                                                @onclick="() => SelectionnerDifficultePrincipale(difficulte)">
                                            <img src="@difficulte.ImageUrl" alt="" />
                                            <span>@difficulte.Nom</span>
                                        </button>
                                    }
                                </div>
                            </div>

                            <div class="difficulte-groupe">
                                <span class="difficulte-groupe-titre">@Texte["Demons", "Demons"]</span>
                                <div class="difficulte-options difficulte-options-principales">
                                    @foreach (Difficulte difficulte in ObtenirDifficultesPrincipales(true))
                                    {
                                        bool estSelectionnee = EstDifficultePrincipaleSelectionnee(difficulte);
                                        <button type="button"
                                                class="difficulte-option @(estSelectionnee ? "selectionnee" : null)"
                                                aria-pressed="@estSelectionnee"
                                                title="@difficulte.Nom"
                                                @onclick="() => SelectionnerDifficultePrincipale(difficulte)">
                                            <img src="@difficulte.ImageUrl" alt="" />
                                            <span>@difficulte.Nom</span>
                                        </button>
                                    }
                                </div>
                            </div>

                            @if (ObtenirVariantesDifficulteSelectionnee() is { Count: > 1 } variantes)
                            {
                                <div class="difficulte-groupe difficulte-groupe-variantes">
                                    <span class="difficulte-groupe-titre">@Texte["Rating", "Rating"]</span>
                                    <div class="difficulte-options difficulte-options-variantes">
                                        @foreach (Difficulte variante in variantes)
                                        {
                                            bool estSelectionnee = _formRatingId == variante.Id;
                                            <button type="button"
                                                    class="difficulte-option difficulte-variante @(estSelectionnee ? "selectionnee" : null)"
                                                    aria-pressed="@estSelectionnee"
                                                    title="@variante.Nom"
                                                    @onclick="() => SelectionnerVarianteDifficulte(variante)">
                                                <img src="@variante.ImageUrl" alt="" />
                                                <span>@ObtenirNomVarianteDifficulte(variante)</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="champ champ-autocomplete champ-publisher">
                        <label for="niveau-publisher">@Texte["Publieur", "Publieur"]</label>
                        <input id="niveau-publisher" class="input" value="@_formPublisherInput" @oninput="OnPublisherInput" autocomplete="off" placeholder="@Texte["NomPublieur", "Nom du publieur"]" />
                        @if (_formPublisherSuggestions.Count > 0)
                        {
                            <div class="suggestions">
                                @foreach (UtilisateurSuggestion suggestion in _formPublisherSuggestions)
                                {
                                    <div class="suggestion suggestion-discord" @onclick="() => SelectPublisher(suggestion)">
                                        <span class="suggestion-nom">@suggestion.Nom</span>
                                        @if (suggestion.DiscordUsername is not null || suggestion.DiscordDisplayName is not null)
                                        {
                                            <span class="suggestion-discord-info">Discord : @(suggestion.DiscordDisplayName ?? "?") (@(suggestion.DiscordUsername ?? "?"))</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="champ champ-autocomplete champ-verifieur">
                        <div class="champ-entete-actions">
                            <label for="niveau-verifieur">@Texte["Verifieur", "Vérifieur"]</label>
                            @if (_niveauEnEditionId is null && !string.IsNullOrWhiteSpace(_formPublisherInput))
                            {
                                <button type="button" class="btn-reprendre-publieur" @onclick="UtiliserPublieurCommeVerifieur">@Texte["UtiliserPublieur", "Utiliser le publieur"]</button>
                            }
                        </div>
                        <input id="niveau-verifieur" class="input" value="@_formVerifieurInput" @oninput="OnVerifieurInput" autocomplete="off" placeholder="@Texte["NomVerifieur", "Nom du vérifieur"]" />
                        @if (_formVerifieurSuggestions.Count > 0)
                        {
                            <div class="suggestions">
                                @foreach (UtilisateurSuggestion suggestion in _formVerifieurSuggestions)
                                {
                                    <div class="suggestion suggestion-discord" @onclick="() => SelectVerifieur(suggestion)">
                                        <span class="suggestion-nom">@suggestion.Nom</span>
                                        @if (suggestion.DiscordUsername is not null || suggestion.DiscordDisplayName is not null)
                                        {
                                            <span class="suggestion-discord-info">Discord : @(suggestion.DiscordDisplayName ?? "?") (@(suggestion.DiscordUsername ?? "?"))</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="champ champ-autocomplete champ-createurs">
                        <div class="champ-entete-actions">
                            <label for="niveau-createurs">@Texte["CreateursRequis", "Créateurs *"]</label>
                            @if (_niveauEnEditionId is null && !string.IsNullOrWhiteSpace(_formPublisherInput))
                            {
                                <button type="button" class="btn-reprendre-publieur" @onclick="AjouterPublieurCommeCreateur">@Texte["AjouterPublieur", "Ajouter le publieur"]</button>
                            }
                        </div>
                        <div class="ligne-ajout">
                            <textarea id="niveau-createurs" class="input input-createur-simple" @bind="_formCreateurInput" @bind:event="oninput" @bind:after="OnCreateurInput" rows="1" autocomplete="off" placeholder="@Texte["NomCreateur", "Nom d'un créateur"]"></textarea>
                            <button type="button" class="btn" @onclick="() => AjouterCreateur(null)">@Texte["Ajouter", "Ajouter"]</button>
                        </div>
                        <button type="button"
                                class="btn-ajout-masse"
                                aria-expanded="@_afficherAjoutCreateursEnMasse"
                                @onclick="BasculerAjoutCreateursEnMasse">
                            @(_afficherAjoutCreateursEnMasse
                                ? Texte["FermerAjoutCreateursEnMasse", "Fermer l'ajout en masse"]
                                : Texte["OuvrirAjoutCreateursEnMasse", "Ajouter plusieurs créateurs"])
                        </button>
                        @if (_afficherAjoutCreateursEnMasse)
                        {
                            <div class="ajout-createurs-masse">
                                <label for="niveau-createurs-masse">@Texte["CreateursEnMasse", "Créateurs à ajouter en masse"]</label>
                                <textarea id="niveau-createurs-masse"
                                          class="input input-createurs-masse"
                                          @bind="_formCreateursEnMasse"
                                          @bind:event="oninput"
                                          rows="7"
                                          placeholder="@Texte["CreateursEnMassePlaceholder", "Un créateur par ligne"]"></textarea>
                                <span class="aide-createurs-masse">@Texte["CreateursEnMasseAide", "Chaque retour à la ligne sépare deux créateurs. Les espaces restent dans le pseudo."]</span>
                                <button type="button"
                                        class="btn"
                                        disabled="@string.IsNullOrWhiteSpace(_formCreateursEnMasse)"
                                        @onclick="AjouterCreateursEnMasse">
                                    @Texte["AjouterTousCreateurs", "Ajouter tous les créateurs"]
                                </button>
                            </div>
                        }
                        @if (_formCreateurSuggestions.Count > 0)
                        {
                            <div class="suggestions">
                                @foreach (UtilisateurSuggestion suggestion in _formCreateurSuggestions)
                                {
                                    <div class="suggestion suggestion-discord" @onclick="() => AjouterCreateur(suggestion)">
                                        <span class="suggestion-nom">@suggestion.Nom</span>
                                        @if (suggestion.DiscordUsername is not null || suggestion.DiscordDisplayName is not null)
                                        {
                                            <span class="suggestion-discord-info">Discord : @(suggestion.DiscordDisplayName ?? "?") (@(suggestion.DiscordUsername ?? "?"))</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        @if (_formCreateurs.Count > 0)
                        {
                            <div class="chips-createurs">
                                @foreach (string nom in _formCreateurs)
                                {
                                    <span class="chip-createur">
                                        @nom
                                        <button type="button" title="@Texte["Retirer", "Retirer"]" @onclick="() => RetirerCreateur(nom)">×</button>
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    @if (_niveauEnEditionId is null)
                    {
                        <div class="champ champ-position">
                            <label for="niveau-position">@Texte["PositionListe", "Position dans la liste"]</label>
                            <input id="niveau-position" type="number" min="1" max="@(_classements.Count + 1)" class="input" @bind="_formPosition" @bind:event="oninput" />
                            @{
                                (string? nomAuDessus, string? nomEnDessous) = ObtenirVoisinsPosition();
                            }
                            <div class="details">
                                <span class="chip">@Texte.Formater("EnDessousDe", "En dessous de : {0}", nomAuDessus ?? Texte["TeteListe", "— (tête de liste)"])</span>
                                <span class="chip">@Texte.Formater("AuDessusDe", "Au-dessus de : {0}", nomEnDessous ?? Texte["FinListe", "— (fin de liste)"])</span>
                            </div>
                        </div>
                    }

                    <div class="champ champ-miniature">
                        <label>@Texte["MiniatureNiveau", "Miniature du niveau *"]</label>
                        <InputFile id="niveau-miniature-input" class="input-fichier-cache" hidden OnChange="OnMiniatureNiveauSelected" accept="image/*" />
                        <div class="miniature-zone @(!string.IsNullOrWhiteSpace(_formMiniatureNiveauBase64) ? "avec-apercu" : "sans-apercu")">
                            @if (!string.IsNullOrWhiteSpace(_formMiniatureNiveauBase64))
                            {
                                <img class="apercu-miniature" src="data:@(_formMiniatureNiveauContentType ?? "image/png");base64,@_formMiniatureNiveauBase64" alt="@Texte["ApercuMiniature", "Aperçu de la miniature"]" />
                                <div class="miniature-actions">
                                    <span>@Texte["ApercuListeMiniature", "Aperçu utilisé dans la liste"]</span>
                                    <label for="niveau-miniature-input" class="btn-fichier">@Texte["ChangerMiniature", "Changer la miniature"]</label>
                                </div>
                            }
                            else
                            {
                                <span class="miniature-vide">@Texte["AucuneMiniature", "Aucune miniature sélectionnée"]</span>
                                <label for="niveau-miniature-input" class="btn-fichier">@Texte["ChoisirFichier", "Choisir un fichier"]</label>
                            }
                        </div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_formErreur))
                {
                    <div class="alert alert-error">@_formErreur</div>
                }

                <div class="actions-formulaire">
                    <button type="button" class="btn" @onclick="EnregistrerNiveau"
                            disabled="@(_formEnCours || _formIdDuNiveauErreur is not null)">
                        @(_formEnCours ? Texte["Enregistrement", "Enregistrement..."] : (_niveauEnEditionId is null ? Texte["CreerNiveau", "Créer le niveau"] : Texte["EnregistrerModifications", "Enregistrer les modifications"]))
                    </button>
                    <button type="button" class="btn-secondaire" @onclick="() => _ongletActuel = Onglet.Niveaux">@Texte["Annuler", "Annuler"]</button>
                </div>
            </div>
            }
        }
        else if (_ongletActuel == Onglet.Soumissions)
        {
            <div class="table-niveaux">
                @if (!string.IsNullOrWhiteSpace(_soumissionErreur))
                {
                    <div class="alert alert-error">@_soumissionErreur</div>
                }

                @if (_soumissions.Count == 0)
                {
                    <p class="aucun-niveau">@Texte["AucuneSoumissionAttente", "Aucune soumission en attente."]</p>
                }
                else
                {
                    @foreach (SoumissionNiveau soumission in _soumissions)
                    {
                        string? urlIframe = VideoUtils.ObtenirUrlIframe(soumission.UrlVideo);
                        bool estOuverte = _soumissionOuverteId == soumission.IdSoumission;
                        bool enFermeture = _soumissionEnFermetureId == soumission.IdSoumission;

                        <div class="carte-soumission @(enFermeture ? "fermeture" : "")" @key="soumission.IdSoumission">
                            <div class="ligne-header" @onclick="() => ToggleSoumission(soumission.IdSoumission)">
                                <div class="infos">
                                    <span class="nom">@soumission.Niveau?.Nom</span>
                                    <div class="details">
                                        <span class="chip">@Texte.Formater("ParAuteur", "par {0}", soumission.NomUtilisateur)</span>
                                        <span class="chip">@soumission.DateSoumission.ToString("g", Texte.Culture)</span>
                                    </div>
                                </div>

                                <div class="actions" @onclick:stopPropagation="true">
                                    <button type="button" disabled="@(_soumissionEnCoursId == soumission.IdSoumission)" @onclick="() => AccepterSoumission(soumission.IdSoumission)">@Texte["Accepter", "Accepter"]</button>
                                    <button type="button" class="btn-danger" disabled="@(_soumissionEnCoursId == soumission.IdSoumission)" @onclick="() => RefuserSoumission(soumission.IdSoumission)">@Texte["Refuser", "Refuser"]</button>
                                </div>

                                <span class="chevron-soumission @(estOuverte ? "ouvert" : "")" aria-hidden="true"></span>
                            </div>

                            <div class="corps-soumission @(estOuverte ? "ouvert" : "")">
                                @if (urlIframe is not null)
                                {
                                    <div class="video-16x9">
                                        <iframe src="@urlIframe" title="@Texte["VideoSoumission", "Vidéo de la soumission"]" frameborder="0" allowfullscreen></iframe>
                                    </div>
                                }

                                <div class="liens-soumission">
                                    @if (urlIframe is null && !string.IsNullOrWhiteSpace(soumission.UrlVideo))
                                    {
                                        <a class="chip" href="@soumission.UrlVideo" target="_blank" rel="noopener noreferrer">@Texte["VoirVideo", "Voir la vidéo"]</a>
                                    }
                                    else if (string.IsNullOrWhiteSpace(soumission.UrlVideo))
                                    {
                                        <span class="chip">@Texte["SansVideo", "Sans vidéo"]</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(soumission.RawFootageUrl))
                                    {
                                        <a class="chip" href="@soumission.RawFootageUrl" target="_blank" rel="noopener noreferrer">@Texte["VoirRawFootage", "Voir le Raw Footage"]</a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }
        else if (_ongletActuel == Onglet.Parametres && PeutVoirOngletParametres)
        {
            <EditForm Model="@this">
                <div id="parametres-haut" class="formulaire-parametres">
                    <header class="parametres-entete">
                        <h2>@Texte["ParametresListe", "Paramètres de la liste"]</h2>
                        <p>@Texte["ParametresListeAide", "Personnalisez les informations publiques et les règles de votre liste."]</p>
                    </header>

                    @if (_parametresSauvegardes)
                    {
                        <div class="alert alert-success">@Texte["ModificationsSauvegardees", "Modifications sauvegardées."]</div>
                    }

                    @if (!string.IsNullOrEmpty(_parametresErreur))
                    {
                        <div class="alert alert-error">@_parametresErreur</div>
                    }

                    <section class="parametres-section">
                        <div class="parametres-section-entete">
                            <h3>@Texte["InformationsGenerales", "Informations générales"]</h3>
                            <p>@Texte["InformationsGeneralesAide", "Ces informations sont visibles sur les pages publiques de la liste."]</p>
                        </div>

                        <div class="parametres-grille">
                            <div class="champ parametre-nom">
                                <label for="liste-nom">@Texte["NomListe", "Nom de la liste *"]</label>
                                <input id="liste-nom" class="input" @bind="_listeNom" @bind:event="oninput" maxlength="128" />
                            </div>

                            <div class="champ parametre-discord">
                                <label for="liste-discord">@Texte["LienDiscord", "Lien du serveur Discord"]</label>
                                <input id="liste-discord" class="input" @bind="_listeDiscordServerUrl" @bind:event="oninput" placeholder="https://discord.gg/..." />
                            </div>

                            <div class="champ parametre-description">
                                <label for="liste-description">@Texte["Description", "Description"]</label>
                                <textarea id="liste-description" class="input input-textarea" @bind="_listeDescription" rows="4" placeholder="@Texte["DescriptionListePlaceholder", "Description de votre liste..."]"></textarea>
                            </div>

                            <label class="parametre-switch" for="liste-publique">
                                <input id="liste-publique" type="checkbox" @bind="_listeEstPublique" />
                                <span class="parametre-switch-piste" aria-hidden="true"></span>
                                <span class="parametre-switch-texte">
                                    <strong>@Texte["ListePublique", "Liste publique"]</strong>
                                    <small>@Texte["ListePubliqueVisible", "La liste est visible par tous les utilisateurs."]</small>
                                </span>
                            </label>
                        </div>
                    </section>

                    <section class="parametres-section">
                        <div class="parametres-section-entete">
                            <h3>@Texte["Apparence", "Apparence"]</h3>
                            <p>@Texte["ApparenceListeAide", "Choisissez l'image affichée derrière les pages de votre liste."]</p>
                        </div>

                        <div class="champ parametre-background">
                            <label for="liste-background">@Texte["ImageFond", "Image de fond"]</label>
                            <InputFile id="liste-background" class="input-fichier-cache" hidden OnChange="OnBackgroundImageSelected" accept="image/*" />
                            <div class="background-zone @(_listeAUneImageDeFond || _backgroundImageBytes != null ? "avec-apercu" : "sans-apercu")">
                                @if (_backgroundImageBytes != null)
                                {
                                    <img class="apercu-background" src="@($"data:{_backgroundImageContentType};base64,{Convert.ToBase64String(_backgroundImageBytes)}")" alt="@Texte["ApercuImageFond", "Aperçu de l'image de fond"]" />
                                }
                                else if (_listeAUneImageDeFond)
                                {
                                    <img class="apercu-background" src="@($"/BackgroundsListes/{_listeId}.png?v={_imageDeFondVersion}")" alt="@Texte["ImageFondActuelle", "Image de fond actuelle"]" />
                                }
                                else
                                {
                                    <span class="background-vide">@Texte["AucuneImageFond", "Aucune image de fond sélectionnée"]</span>
                                }

                                <div class="background-actions">
                                    @if (_listeAUneImageDeFond || _backgroundImageBytes != null)
                                    {
                                        <span>@(_backgroundImageBytes != null ? Texte["NouvelApercu", "Nouvel aperçu"] : Texte["ImageActuelle", "Image actuelle"])</span>
                                    }
                                    <label for="liste-background" class="btn-fichier">@(_listeAUneImageDeFond || _backgroundImageBytes != null ? Texte["ChangerImage", "Changer l'image"] : Texte["ChoisirFichier", "Choisir un fichier"])</label>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="parametres-section">
                        <div class="parametres-section-entete">
                            <h3>@Texte["PreuvesVideo", "Preuves vidéo"]</h3>
                            <p>@Texte["PreuvesVideoAide", "Définissez quand une vidéo de réussite et une vidéo brute sont obligatoires."]</p>
                        </div>

                        <div class="parametres-preuve-video">
                            <div class="parametres-sous-section-entete">
                                <h4>@Texte["VideoReussite", "Besoin d'une vidéo"]</h4>
                                <p>@Texte["VideoReussiteAide", "Les réussites sans vidéo obligatoire sont validées immédiatement."]</p>
                            </div>

                            <label class="parametre-switch">
                                <input type="checkbox" checked="@_videoToujoursRequise" @onchange="OnVideoToujoursRequiseChange" />
                                <span class="parametre-switch-piste" aria-hidden="true"></span>
                                <span class="parametre-switch-texte">
                                    <strong>@Texte["VideoToujoursRequise", "Vidéo obligatoire pour tous les niveaux"]</strong>
                                    <small>@Texte["VideoToujoursRequiseAide", "Désactivez cette option pour définir les niveaux qui nécessitent une preuve."]</small>
                                </span>
                            </label>

                            @if (!_videoToujoursRequise)
                            {
                                <div class="criteres-video">
                                    <div class="critere-video">
                                        <label class="parametre-switch parametre-switch-compact">
                                            <input type="checkbox" checked="@_videoDifficulteMinimaleId.HasValue" @onchange="OnCritereDifficulteVideoChange" />
                                            <span class="parametre-switch-piste" aria-hidden="true"></span>
                                            <span class="parametre-switch-texte">
                                                <strong>@Texte["SeuilDifficulteVideo", "Seuil de difficulté"]</strong>
                                                <small>@Texte["SeuilDifficulteVideoAide", "Les difficultés inférieures n'auront pas besoin de vidéo."]</small>
                                            </span>
                                        </label>

                                        @if (_videoDifficulteMinimaleId.HasValue)
                                        {
                                            <div class="champ">
                                                <label for="video-difficulte-minimale">@Texte["DifficulteMinimaleVideo", "Vidéo requise à partir de"]</label>
                                                <select id="video-difficulte-minimale" class="input" @bind="_videoDifficulteMinimaleId">
                                                    @foreach (Difficulte difficulte in ObtenirDifficultesVideoDisponibles())
                                                    {
                                                        <option value="@difficulte.Id">@difficulte.Nom</option>
                                                    }
                                                </select>
                                            </div>
                                        }
                                    </div>

                                    <div class="critere-video">
                                        <label class="parametre-switch parametre-switch-compact">
                                            <input type="checkbox" checked="@_videoTopStart.HasValue" @onchange="OnCritereClassementVideoChange" />
                                            <span class="parametre-switch-piste" aria-hidden="true"></span>
                                            <span class="parametre-switch-texte">
                                                <strong>@Texte["SeuilClassementVideo", "Seuil de classement"]</strong>
                                                <small>@Texte["SeuilClassementVideoAide", "La vidéo sera obligatoire à partir d'une position choisie."]</small>
                                            </span>
                                        </label>

                                        @if (_videoTopStart.HasValue)
                                        {
                                            <div class="champ parametre-top-depart">
                                                <label for="video-top">@Texte["TopDepartVideo", "Top de départ"]</label>
                                                <input id="video-top" type="number" min="1" class="input" @bind="_videoTopStart" />
                                                <small>@Texte["TopDepartVideoAide", "Exemple : 10 exige une vidéo pour les niveaux classés du top 10 au top 1."]</small>
                                            </div>
                                        }
                                    </div>
                                </div>

                                @if (_videoDifficulteMinimaleId.HasValue && _videoTopStart.HasValue)
                                {
                                    <p class="aide-criteres-video">@Texte["DeuxCriteresVideoAide", "La vidéo est obligatoire dès que le niveau atteint l'un des deux seuils."]</p>
                                }
                            }
                        </div>

                        <div class="parametres-raw-footage">
                            <div class="parametres-sous-section-entete">
                                <h4>@Texte["VideoBrute", "Vidéo brute"]</h4>
                                <p>@Texte["VideoBruteAide", "Ajoutez une preuve brute en complément de la vidéo de réussite."]</p>
                            </div>
                            <div class="champ">
                                <label for="raw-footage-mode">@Texte["RawFootageRequisLabel", "Raw Footage requis"]</label>
                                <div class="parametre-combobox @(_menuRawFootageOuvert ? "ouvert" : "")">
                                    <button id="raw-footage-mode"
                                            type="button"
                                            class="parametre-combobox-trigger"
                                            aria-haspopup="listbox"
                                            aria-expanded="@_menuRawFootageOuvert"
                                            @onclick="BasculerMenuRawFootage">
                                        <span>@NomModeRawFootage(_rawFootageMode)</span>
                                        <span class="parametre-combobox-chevron" aria-hidden="true"></span>
                                    </button>

                                    @if (_menuRawFootageOuvert)
                                    {
                                        <div class="parametre-combobox-options" role="listbox" aria-label="@Texte["RawFootageRequisLabel", "Raw Footage requis"]">
                                            @foreach (RawFootageMode mode in Enum.GetValues<RawFootageMode>())
                                            {
                                                <button type="button"
                                                        role="option"
                                                        aria-selected="@(mode == _rawFootageMode)"
                                                        class="parametre-combobox-option @(mode == _rawFootageMode ? "active" : "")"
                                                        @onclick="() => ChoisirModeRawFootage(mode)">
                                                    <span>@NomModeRawFootage(mode)</span>
                                                    <small>@DescriptionModeRawFootage(mode)</small>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                                <small>@DescriptionModeRawFootage(_rawFootageMode)</small>
                            </div>

                            @if (_rawFootageMode == RawFootageMode.FromTop)
                            {
                                <div class="champ parametre-top-depart">
                                    <label for="raw-footage-top">@Texte["TopDepart", "Top de départ"]</label>
                                    <input id="raw-footage-top" type="number" min="1" class="input" @bind="_rawFootageTopStart" />
                                    <small>@Texte["TopDepartAide", "Exemple : 12 demande une vidéo brute pour les niveaux classés de 12 à 1."]</small>
                                </div>
                            }
                        </div>
                    </section>

                    <div class="actions-formulaire">
                        <button type="button" class="btn" @onclick="SauvegarderParametres" disabled="@_parametresEnCours">
                            @(_parametresEnCours ? Texte["Sauvegarde", "Sauvegarde..."] : Texte["Sauvegarder", "Sauvegarder"])
                        </button>
                        <button type="button" class="btn-secondaire" @onclick="() => _ongletActuel = Onglet.Niveaux">@Texte["Annuler", "Annuler"]</button>
                    </div>

                    <section class="zone-danger">
                        <div>
                            <h3>@Texte["SupprimerListe", "Supprimer la liste"]</h3>
                            <p>@Texte["SupprimerListeAide", "La liste disparaîtra du site, mais vous pourrez la restaurer depuis son historique."]</p>
                        </div>
                        <button type="button" class="btn-danger" @onclick="OuvrirSuppressionListe">@Texte["SupprimerListe", "Supprimer la liste"]</button>
                    </section>
                </div>
            </EditForm>
        }
        else if (_ongletActuel == Onglet.Moderation && PeutVoirOngletModeration)
        {
            <div class="formulaire-moderation">
                <header class="moderation-entete">
                    <div>
                        <h2>@Texte["Moderation", "Modération"]</h2>
                        <p>@Texte["ModerationAide", "Gérez les membres autorisés à intervenir sur cette liste."]</p>
                    </div>
                    <span class="moderation-compteur">@Texte.Formater(_membres.Count == 0 ? "MembreCompte" : "MembresCompte", _membres.Count == 0 ? "{0} membre" : "{0} membres", _membres.Count + 1)</span>
                </header>

                @if (!string.IsNullOrEmpty(_moderationErreur))
                {
                    <div class="alert alert-error">@_moderationErreur</div>
                }

                <section class="moderation-section moderation-membres">
                    <div class="moderation-section-entete">
                        <h3>@Texte["MembresRoles", "Membres et rôles"]</h3>
                        <p>@Texte["ProprietaireDroits", "Le propriétaire possède toujours tous les droits sur la liste."]</p>
                    </div>

                    <div class="moderation-liste">
                        <div class="membre-ligne membre-proprietaire">
                            <div class="membre-infos">
                                <span class="membre-nom">@_proprietaireNomSite</span>
                                <span class="membre-discord">Discord : @(_proprietaireDiscordDisplayName ?? "?") (@(_proprietaireDiscordUsername ?? "?"))</span>
                            </div>
                            <div class="membre-actions">
                                <span class="membre-role-badge role-proprietaire">@Texte["Proprietaire", "Propriétaire"]</span>
                            </div>
                        </div>

                        @if (_membres.Count == 0)
                        {
                            <p class="moderation-vide">@Texte["AucunAutreMembre", "Aucun autre membre n'a de rôle sur cette liste."]</p>
                        }
                        else
                        {
                            @foreach (MembreLigne membre in _membres)
                            {
                                RoleListe roleSelectionne = ObtenirRoleMembreSelectionne(membre);
                                bool roleModifie = roleSelectionne != membre.Role;

                                <div class="membre-ligne">
                                    <div class="membre-infos">
                                        <span class="membre-nom">@membre.NomSite</span>
                                        <span class="membre-discord">Discord : @(membre.DiscordDisplayName ?? "?") (@(membre.DiscordUsername ?? "?"))</span>
                                    </div>
                                    <div class="membre-actions">
                                        @if (PeutRevoquerRole(membre.Role))
                                        {
                                            <div class="role-combobox @(roleModifie ? "modifie" : "") @(_menuRoleMembreOuvertId == membre.UtilisateurId ? "ouvert" : "")">
                                                <button type="button"
                                                        class="role-combobox-trigger"
                                                        aria-label="@Texte.Formater("RoleDe", "Rôle de {0}", membre.NomSite)"
                                                        aria-haspopup="listbox"
                                                        aria-expanded="@(_menuRoleMembreOuvertId == membre.UtilisateurId)"
                                                        title="@DescriptionRole(roleSelectionne)"
                                                        @onclick="() => BasculerMenuRoleMembre(membre.UtilisateurId)">
                                                    <span>@NomRole(roleSelectionne)</span>
                                                    <span class="role-combobox-chevron" aria-hidden="true"></span>
                                                </button>

                                                @if (_menuRoleMembreOuvertId == membre.UtilisateurId)
                                                {
                                                    <div class="role-combobox-options" role="listbox" aria-label="@Texte["ChoisirRole", "Choisir un rôle"]">
                                                        @foreach (RoleListe role in RolesAssignables)
                                                        {
                                                            <button type="button"
                                                                    role="option"
                                                                    aria-selected="@(role == roleSelectionne)"
                                                                    class="role-combobox-option @(role == roleSelectionne ? "active" : "")"
                                                                    title="@DescriptionRole(role)"
                                                                    @onclick="() => ChoisirRoleMembre(membre, role)">
                                                                @NomRole(role)
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="membre-role-badge">@NomRole(membre.Role)</span>
                                        }

                                        @if (roleModifie)
                                        {
                                            <button type="button"
                                                    class="role-valider"
                                                    title="@Texte["EnregistrerNouveauRole", "Enregistrer le nouveau rôle"]"
                                                    @onclick="() => ValiderRoleMembreAsync(membre)">
                                                @Texte["Valider", "Valider"]
                                            </button>
                                        }

                                        @if (PeutRevoquerRole(membre.Role))
                                        {
                                            <button type="button" class="membre-retirer" @onclick="() => DemanderRevocation(membre)">@Texte["Retirer", "Retirer"]</button>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </section>

                @if (_afficherConfirmationRevocation && _membreARevoquer is not null)
                {
                    <div class="modal-backdrop" @onclick="AnnulerRevocation"></div>
                    <div class="modal-confirm">
                        <p>@Texte.Formater("RetirerRoleQuestion", "Retirer le rôle {0} de {1} ?", NomRole(_membreARevoquer.Role), _membreARevoquer.NomSite)</p>
                        <div class="modal-actions">
                            <button type="button" class="btn-danger" @onclick="ConfirmerRevocation">@Texte["Confirmer", "Confirmer"]</button>
                            <button type="button" @onclick="AnnulerRevocation">@Texte["Annuler", "Annuler"]</button>
                        </div>
                    </div>
                }

                <section class="ajout-membre moderation-section">
                    <div class="moderation-section-entete">
                        <h3>@Texte["AttribuerRole", "Attribuer un rôle"]</h3>
                        <p>@Texte["AttribuerRoleAide", "Recherchez un utilisateur avec son nom du site ou son compte Discord."]</p>
                    </div>

                    <div class="champ champ-autocomplete recherche-membre">
                        <label for="membre-recherche">@Texte["Utilisateur", "Utilisateur"]</label>
                        <input id="membre-recherche" class="input" value="@_rechercheMembreInput" @oninput="OnRechercheMembreInput" autocomplete="off" placeholder="@Texte["RechercheUtilisateurDiscord", "Nom dans le site, pseudo ou tag Discord..."]" />
                        @if (_rechercheMembreSuggestions.Count > 0)
                        {
                            <div class="suggestions">
                                @foreach (DiscordUtilisateurSuggestion candidat in _rechercheMembreSuggestions)
                                {
                                    <div class="suggestion suggestion-discord" @onclick="() => SelectCandidatMembre(candidat)">
                                        <span class="suggestion-nom">@candidat.NomSite</span>
                                        <span class="suggestion-discord-info">Discord : @(candidat.DiscordDisplayName ?? "?") (@(candidat.DiscordUsername ?? "?"))</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    @if (_candidatSelectionne is not null)
                    {
                        <div class="candidat-selectionne">
                            <div class="membre-infos">
                                <span class="membre-nom">@_candidatSelectionne.NomSite</span>
                                <span class="membre-discord">Discord : @(_candidatSelectionne.DiscordDisplayName ?? "?") (@(_candidatSelectionne.DiscordUsername ?? "?"))</span>
                            </div>
                            <span class="candidat-badge">@Texte["Selectionne", "Sélectionné"]</span>
                        </div>

                        <div class="attribution-role">
                            <div class="champ">
                                <label for="membre-role">@Texte["Role", "Rôle"]</label>
                                <div class="role-combobox role-combobox-attribution @(_menuRoleAttributionOuvert ? "ouvert" : "")">
                                    <button id="membre-role"
                                            type="button"
                                            class="role-combobox-trigger"
                                            aria-haspopup="listbox"
                                            aria-expanded="@_menuRoleAttributionOuvert"
                                            title="@DescriptionRole(_roleAAssigner)"
                                            @onclick="BasculerMenuRoleAttribution">
                                        <span>@NomRole(_roleAAssigner)</span>
                                        <span class="role-combobox-chevron" aria-hidden="true"></span>
                                    </button>

                                    @if (_menuRoleAttributionOuvert)
                                    {
                                        <div class="role-combobox-options" role="listbox" aria-label="@Texte["ChoisirRole", "Choisir un rôle"]">
                                            @foreach (RoleListe role in RolesAssignables)
                                            {
                                                <button type="button"
                                                        role="option"
                                                        aria-selected="@(role == _roleAAssigner)"
                                                        class="role-combobox-option @(role == _roleAAssigner ? "active" : "")"
                                                        title="@DescriptionRole(role)"
                                                        @onclick="() => ChoisirRoleAttribution(role)">
                                                    @NomRole(role)
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                                <small>@DescriptionRole(_roleAAssigner)</small>
                            </div>

                            <div class="actions-formulaire actions-attribution">
                                <button type="button" class="btn" @onclick="AssignerRoleAsync" disabled="@_assignationEnCours">
                                    @(_assignationEnCours ? Texte["AttributionEnCours", "Attribution..."] : Texte.Formater("AttribuerA", "Attribuer à {0}", _candidatSelectionne.NomSite))
                                </button>
                            </div>
                        </div>
                    }
                </section>
            </div>
        }
        else if (_ongletActuel == Onglet.Historique && PeutVoirOngletHistorique)
        {
            <section class="historique-page">
                <header class="historique-entete">
                    <div>
                        <h2>@Texte["HistoriqueListe", "Historique de la liste"]</h2>
                        <p>@Texte["HistoriqueListeAide", "Consultez les actions correspondant à vos permissions et annulez celles que votre rôle vous autorise à gérer."]</p>
                    </div>
                    <span class="historique-compteur">@Texte.Formater("ActionsCompte", "{0} actions", _historiques.Count)</span>
                </header>

                @if (!string.IsNullOrWhiteSpace(_historiqueSucces))
                {
                    <div class="alert alert-success">@_historiqueSucces</div>
                }

                @if (!string.IsNullOrWhiteSpace(_historiqueErreur))
                {
                    <div class="alert alert-error">@_historiqueErreur</div>
                }

                @if (_historiques.Count == 0)
                {
                    <div class="historique-vide">
                        <strong>@Texte["AucuneAction", "Aucune action enregistrée"]</strong>
                        <span>@Texte["AucuneActionAide", "Les prochaines modifications apparaîtront ici."]</span>
                    </div>
                }
                else
                {
                    <div class="historique-liste">
                        @foreach (HistoriqueListe historique in _historiques)
                        {
                            <article class="historique-action @(historique.DateAnnulation is not null ? "annulee" : "")">
                                <div class="historique-avatar" aria-hidden="true">@InitialeAuteur(historique)</div>
                                <div class="historique-contenu">
                                    <div class="historique-ligne-haut">
                                        <span class="historique-type">@LibelleAction(historique.TypeAction)</span>
                                        <time datetime="@historique.DateCreation.ToString("O")">@historique.DateCreation.ToString("g", Texte.Culture)</time>
                                    </div>
                                    <p>@DescriptionAction(historique)</p>
                                    <span class="historique-auteur">@Texte.Formater("ParAuteur", "par {0}", historique.Utilisateur?.Nom ?? Texte["Systeme", "Système"])</span>
                                    @if (historique.DateAnnulation is not null)
                                    {
                                        <span class="historique-statut">@Texte.Formater("ActionAnnuleePar", "Annulée par {0}", historique.AnnuleeParUtilisateur?.Nom ?? Texte["LeProprietaire", "le propriétaire"])</span>
                                    }
                                </div>
                                @if (PeutAnnulerMaintenant(historique))
                                {
                                    <button type="button" class="historique-annuler" @onclick="() => OuvrirAnnulation(historique)">@Texte["Annuler", "Annuler"]</button>
                                }
                                else if (PeutAnnulerSelonRole(historique) && historique.PeutEtreAnnulee && historique.DateAnnulation is null)
                                {
                                    <span class="historique-verrouillee">@Texte["ActionRecenteDabord", "Action plus récente à annuler d'abord"]</span>
                                }
                            </article>
                        }
                    </div>
                }
            </section>
        }
      </div>
    </div>

    @if (_afficherConfirmationSuppressionListe)
    {
        <div class="modal-backdrop" @onclick="FermerSuppressionListe"></div>
        <div class="modal-confirm modal-liste-danger" role="dialog" aria-modal="true" aria-labelledby="suppression-liste-titre">
            <h2 id="suppression-liste-titre">@Texte.Formater("SupprimerListeQuestion", "Supprimer {0} ?", _listeNom)</h2>
            <p>@Texte["SupprimerListeConfirmationAide", "La liste sera masquée immédiatement. Son historique et toutes ses données seront conservés pour permettre une restauration."]</p>
            <label for="confirmation-nom-liste">@Texte.Formater("SaisirNomConfirmer", "Saisissez {0} pour confirmer", _listeNom)</label>
            <input id="confirmation-nom-liste" class="input" autocomplete="off" @bind="_confirmationNomListe" @bind:event="oninput" />
            <div class="modal-actions">
                <button type="button" class="btn-danger" disabled="@(!NomListeConfirme || _actionHistoriqueEnCours)" @onclick="SupprimerListe">@(_actionHistoriqueEnCours ? Texte["SuppressionEnCours", "Suppression..."] : Texte["SupprimerAffichage", "Supprimer définitivement de l'affichage"])</button>
                <button type="button" disabled="@_actionHistoriqueEnCours" @onclick="FermerSuppressionListe">@Texte["Annuler", "Annuler"]</button>
            </div>
        </div>
    }

    @if (_afficherConfirmationRestaurationListe)
    {
        <div class="modal-backdrop" @onclick="FermerRestaurationListe"></div>
        <div class="modal-confirm" role="dialog" aria-modal="true" aria-labelledby="restauration-liste-titre">
            <h2 id="restauration-liste-titre">@Texte["RestaurerListeQuestion", "Restaurer la liste ?"]</h2>
            <p>@Texte["RestaurerListeConfirmationAide", "Elle redeviendra accessible avec ses niveaux, ses membres et ses réglages."]</p>
            <div class="modal-actions">
                <button type="button" class="btn" disabled="@_actionHistoriqueEnCours" @onclick="RestaurerListe">@(_actionHistoriqueEnCours ? Texte["RestaurationEnCours", "Restauration..."] : Texte["Restaurer", "Restaurer"])</button>
                <button type="button" disabled="@_actionHistoriqueEnCours" @onclick="FermerRestaurationListe">@Texte["Annuler", "Annuler"]</button>
            </div>
        </div>
    }

    @if (_afficherConfirmationAnnulation && _historiqueAAnnuler is not null)
    {
        <div class="modal-backdrop" @onclick="FermerAnnulation"></div>
        <div class="modal-confirm" role="dialog" aria-modal="true" aria-labelledby="annulation-action-titre">
            <h2 id="annulation-action-titre">@Texte["AnnulerActionQuestion", "Annuler cette action ?"]</h2>
            <p>@DescriptionAction(_historiqueAAnnuler)</p>
            <p>@Texte["AnnulerActionAide", "Les données seront remises dans leur état précédent."]</p>
            <div class="modal-actions">
                <button type="button" class="btn-danger" disabled="@_actionHistoriqueEnCours" @onclick="AnnulerAction">@(_actionHistoriqueEnCours ? Texte["AnnulationEnCours", "Annulation..."] : Texte["ConfirmerAnnulation", "Confirmer l'annulation"])</button>
                <button type="button" disabled="@_actionHistoriqueEnCours" @onclick="FermerAnnulation">@Texte["Retour", "Retour"]</button>
            </div>
        </div>
    }
}
